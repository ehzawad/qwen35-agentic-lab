.venv/
out/
data/*
!data/distill.jsonl
__pycache__/
*.pyc
wandb/
# suite v1 payload is regenerated byte-identically from committed seeds
# (44 MB, 3.3 s); the manifest and sums ARE committed so the regeneration is
# verifiable without shipping the data.
!data/suite/
!data/suite/v1/
!data/suite/v1/manifest.json
!data/suite/v1/SHA256SUMS
data/suite/v1/specs/
data/suite/v1/kb/
data/suite/v1/oracles/
data/suite/v1/certspecs/
